{
  "openapi": "3.0.3",
  "info": {
    "title": "Task Management Backend API",
    "version": "1.0.0",
    "description": "OpenAPI specification for the Task Management backend."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "paths": {
    "/api/auth/signup": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Register a new user",
        "responses": {
          "200": {
            "description": "User created"
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Login user and return token",
        "responses": {
          "200": {
            "description": "Login successful"
          }
        }
      }
    },
    "/api/getallusers": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Get all users",
        "responses": {
          "200": {
            "description": "Users fetched"
          }
        }
      }
    },
    "/api/addtask/{id}": {
      "post": {
        "tags": [
          "Tasks"
        ],
        "summary": "Create task for user",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Task created"
          }
        }
      }
    },
    "/api/mytask/{id}": {
      "get": {
        "tags": [
          "Tasks"
        ],
        "summary": "Get tasks assigned to the user",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tasks fetched"
          }
        }
      }
    },
    "/api/updatestatus/{id}": {
      "put": {
        "tags": [
          "Tasks"
        ],
        "summary": "Update task status",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Task updated"
          }
        }
      }
    },
    "/api/gettaskbyid/{id}": {
      "get": {
        "tags": [
          "Tasks"
        ],
        "summary": "Get all tasks by user id",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tasks fetched"
          }
        }
      }
    },
    "/api/getalltask": {
      "get": {
        "tags": [
          "Tasks"
        ],
        "summary": "Get all tasks",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "All tasks fetched"
          }
        }
      }
    }
  }
}
